{
  "name": "effect-test",
  "type": "module",
  "imports": {
    "#server/*": "./server/*",
    "#lib/*": "./lib/*",
    "#client/*": "./client/*"
  },
  "scripts": {
    "predev": "run-s -s db:ensure",
    "worker": "cd worker; bun --env-file=../.env -b graphile-worker",
    "gm": "bun -b graphile-migrate",
    "db:latest": "run-s -s 'gm watch --once'",
    "db:watch": "run-s -s 'gm watch'",
    "db:reset": "run-s -s 'gm reset --erase'",
    "db:up": "docker-compose up -d db",
    "db:stop": "docker-compose stop db",
    "db:exec": "docker-compose exec db",
    "db:types": "kysely-codegen --dialect postgres",
    "db:ensure": "bun ./scripts/dbEnsure.mjs",
    "db:setup": "bun ./scripts/dbSetup.mjs",
    "db:init": "run-s db:up db:setup db:reset db:latest",
    "env:init": "bun ./scripts/generateEnvFile.mjs",
    "init": "NOCONFIRM=1 run-s env:init db:init",
    "tsc:watch": "tsc --watch --noEmit --preserveWatchOutput",
    "server:watch_": "run-p 'server:build --watch' server:exec:watch",
    "server:watch": "bun -b --watch --watch-preserve-output server/index.ts",
    "server:exec": "bun dist/server.js",
    "server:exec:watch": "bun --watch dist/server.js",
    "server:build": "esbuild server/index.ts --format=esm --platform=node --target=node22 --bundle --packages=external --sourcemap=inline --outfile=dist/server.js",
    "client:watch": "node --env-file=.env ./node_modules/.bin/vite dev --clearScreen=false",
    "vitest:run": "node --env-file=.env ./node_modules/.bin/vitest run",
    "vitest:watch": "node --env-file=.env ./node_modules/.bin/vitest dev",
    "test": "run-s vitest:run",
    "dev": "run-p server:watch client:watch db:watch worker"
  },
  "dependencies": {
    "@effect/experimental": "^0.54.5",
    "@effect/opentelemetry": "^0.56.2",
    "@effect/platform": "^0.90.2",
    "@effect/platform-bun": "^0.78.0",
    "@effect/platform-node": "^0.95.0",
    "@effect/rpc": "^0.68.4",
    "@effect/rpc-http": "^0.52.4",
    "@effect/sql": "^0.44.1",
    "@effect/sql-kysely": "^0.40.0",
    "@effect/sql-pg": "^0.45.0",
    "@effect/vitest": "^0.25.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-router": "^1.131.8",
    "effect": "^3.17.7",
    "graphile-migrate": "^1.4.1",
    "graphile-worker": "^0.16.6",
    "html-to-text": "^9.0.5",
    "lodash.template": "^4.5.0",
    "mjml": "^4.15.3",
    "nodemailer": "^7.0.5",
    "npm-run-all": "^4.1.5",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "prettier": "^3.6.2",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.35.2",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/bun": "^1.2.20",
    "cypress": "^14.5.4",
    "kysely-codegen": "^0.18.5",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "private": true
}
