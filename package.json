{
	"name": "effect-test",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "run-s -s db:ensure",
		"worker": "bun --cwd=./worker --env-file=../.env -b graphile-worker",
		"worker:schema": "run-s 'worker --schema-only'",
		"gm": "bun -b graphile-migrate",
		"db:latest": "run-s -s 'gm watch --once'",
		"db:watch": "run-s -s 'gm watch'",
		"db:reset": "run-s -s 'gm reset --erase'",
		"db:up": "docker-compose up -d db",
		"db:stop": "docker-compose stop db",
		"db:exec": "docker-compose exec db",
		"db:types": "kysely-codegen --dialect postgres --out-file ./generated/db.d.ts --type-mapping \"{\\\"int8\\\":\\\"ColumnType<bigint, bigint | number | string, bigint | number | string>\\\"}\"",
		"db:ensure": "bun ./scripts/dbEnsure.mjs",
		"db:setup": "bun ./scripts/dbSetup.mjs",
		"db:init": "run-s db:up db:setup db:reset db:latest worker:schema",
		"env:init": "bun ./scripts/generateEnvFile.mjs",
		"init": "NOCONFIRM=1 run-s env:init db:init",
		"typecheck": "tsc --noEmit",
		"typecheck:watch": "tsc --watch --noEmit",
		"client:watch": "node --env-file=.env ./node_modules/.bin/vite dev --clearScreen=false",
		"build": "NODE_ENV=production node --env-file=.env ./node_modules/.bin/vite build",
		"start": "NODE_ENV=production node --env-file=.env .output/server/index.mjs",
		"vitest:run": "node --env-file=.env ./node_modules/.bin/vitest run",
		"vitest:watch": "node --env-file=.env ./node_modules/.bin/vitest dev",
		"test": "run-s vitest:run",
		"dev": "mprocs 'bun client:watch' 'bun db:watch' 'bun worker' 'bun typecheck:watch' 'bun vitest:watch'",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"gen:constraints": "bun scripts/genFormConstraints.ts"
	},
	"dependencies": {
		"@effect/cluster": "^0.60.2",
		"@effect/experimental": "^0.61.1",
		"@effect/opentelemetry": "^0.64.1",
		"@effect/platform": "^0.97.2",
		"@effect/platform-browser": "^0.77.1",
		"@effect/platform-bun": "^0.91.2",
		"@effect/platform-node": "^0.108.2",
		"@effect/rpc": "^0.76.2",
		"@effect/rpc-http": "^0.52.4",
		"@effect/sql": "^0.52.1",
		"@effect/sql-kysely": "^0.48.0",
		"@effect/sql-pg": "^0.53.0",
		"@effect/vitest": "^0.30.0",
		"@effect/workflow": "^0.19.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/sdk-trace-base": "^2.11.0",
		"@opentelemetry/sdk-trace-node": "^2.11.0",
		"@opentelemetry/sdk-trace-web": "^2.11.0",
		"@tanstack/react-router": "^1.170.36",
		"@tanstack/react-start": "^1.168.54",
		"effect": "^3.22.2",
		"graphile-migrate": "^1.4.1",
		"graphile-worker": "^0.17.3",
		"html-to-text": "^9.0.5",
		"kysely": "0.28.17",
		"lodash.template": "^4.18.1",
		"mjml": "^4.18.0",
		"nodemailer": "^7.0.13",
		"npm-run-all": "^4.1.5",
		"pg": "^8.23.0",
		"pg-error-enum": "^2.0.1",
		"postgres": "^3.4.9",
		"prompts": "^2.4.2"
	},
	"devDependencies": {
		"@effect/language-service": "^0.87.2",
		"@tanstack/nitro-v2-vite-plugin": "^1.155.2",
		"@testcontainers/postgresql": "^12.1.0",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"cypress": "^15.21.1",
		"kysely-codegen": "^0.20.0",
		"mprocs": "^0.9.6",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"kysely": "0.28.17"
	}
}
